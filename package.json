{
  "name": "glb-auto-trade-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:seed": "node --env-file=.env src/seed.js",
    "db:reset": "node --env-file=.env src/seed.js --reset",
