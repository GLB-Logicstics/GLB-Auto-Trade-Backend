    "vercel-build": "node src/seed.js --if-empty"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "@vercel/blob": "^1.1.1"
  }
}